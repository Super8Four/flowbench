# SQLite is stored at RUNS_DIRECTORY/archive.sqlite3; no database service/URL needed.
# Optional: otherwise use bin/iperf3.exe or iperf3 on PATH.
# IPERF_PATH=C:/tools/iperf3/iperf3.exe
# Optional: otherwise use instance/runs under this project.
# RUNS_DIRECTORY=C:/iperf-data/runs
# Optional maintenance-only override: do not resume a saved listener during CLI exports.
# FLOWBENCH_RESUME_LISTENER=0
